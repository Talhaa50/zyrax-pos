# Server Configuration
PORT=3001
NODE_ENV=development

# Authentication
# Use a unique random value of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Server login credentials (seeded at startup if database is empty)
# Do NOT commit real passwords to .env files
RETAILER_ADMIN_PASSWORD=replace_with_a_strong_admin_password
RETAILER_CASHIER_PASSWORD=replace_with_a_strong_cashier_password

# Barcode Lookup API (optional external service)
# Get from https://www.barcodelookup.com/api/
# Leave blank to disable external barcode lookups
BARCODE_API_KEY=

# Database and uploads
# Database: SQLite file created at server/data/pos_data.db
# Uploads: Product images stored at server/public/uploads/products/

