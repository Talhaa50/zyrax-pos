# Server Configuration
PORT=3001
NODE_ENV=development

# Authentication
# Use a unique random value of at least 32 characters.
AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Server login credentials. Do not commit real passwords.
RETAILER_ADMIN_PASSWORD=replace_with_a_strong_admin_password
RETAILER_CASHIER_PASSWORD=replace_with_a_strong_cashier_password

# API Rate Limiting
# Sync: 50 requests/minute per user
# Barcode: 10 requests/minute per user

# Barcode Lookup API (optional external service)
BARCODE_API_KEY=your_barcode_api_key

# SQLite Database
# Database file will be created at server/data/pos_data.db
# Product images stored at server/public/uploads/products/

